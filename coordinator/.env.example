# Puerto HTTP + WebSocket del coordinador (lo usan los jugadores y el mesh por ngrok)
PORT=5000
# Puerto del mesh en LAN (por defecto PORT + 100). Con ngrok (un solo túnel),
# PEER_PORT = PORT: el mesh entra por el mismo puerto (raíz o /mesh) y no se abre otro.
PEER_PORT=5100
PUBLIC_HOST=localhost

# Identificador único de ESTE coordinador (en el PC 1: coord-a, en el PC 2: coord-b, en el PC 3: coord-c)
COORDINATOR_ID=coord-a

# URL pública de ngrok de ESTE coordinador (el link que te da `ngrok http 5000` en este PC, con wss://)
PUBLIC_URL=wss://TU-URL-COORDINADOR.ngrok-free.dev

# Debe ser EXACTAMENTE la misma secret que auth-service/.env (mínimo 32 caracteres).
JWT_SECRET=b1a5a8f05c56428baa5f22e922cd5cd7eebf1a4946f8582608acf2128ba2a310
JWT_CLOCK_TOLERANCE_S=5
SESSION_MAX_AGE=

# Taller 7: los auth replicados, separados por coma. El coordinador manda sus
# heartbeats al líder y, si un auth no responde, prueba el siguiente.
# Ej.: AUTH_URLS=http://localhost:4000,http://localhost:4001,http://localhost:4002
# Vacío = se usa AUTH_URL (un solo auth, como en el Taller 6)
AUTH_URLS=
# URL de ngrok del auth-service (Equipo A - Vivian)
AUTH_URL=https://backside-cufflink-reapprove.ngrok-free.dev
TOKEN_POLICY_POLL_MS=15000
HEARTBEAT_MS=30000

# Mundo del juego
WORLD_WIDTH=2400
WORLD_HEIGHT=1800
PLAYER_RADIUS=20
PLAYER_SPEED=200
TICK_RATE=20
MATCH_SECONDS=180
MATCH_BREAK_SECONDS=10
OBSTACLES=on

# ===== Examen final =====
# Persistencia (track 2.1): SQLite de estado de ESTE coordinador (vacío = state-<id>.db)
STATE_DB=
# Cada cuánto se guarda el mundo (ms) y cuánto vale lo guardado
PERSIST_MS=2000
SAVED_TTL_MS=600000
# Una ronda pausada (nadie conectado / todos los coordinadores caídos) se reanuda si vuelve alguien antes de esto
MATCH_RESUME_MS=600000
# Espectadores (track 2.5): máximo por coordinador y cada cuántos ticks reciben el state (2 = 10 Hz)
MAX_SPECTATORS=50
SPECTATOR_EVERY=2
# Chat (track 2.6): últimos mensajes que se guardan y se mandan al conectarse
CHAT_HISTORY=50

# Puerto HTTP + WebSocket del coordinador
PORT=5000
# Debe ser EXACTAMENTE la misma secret que auth-service/.env
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
# Intervalo del heartbeat (ping/pong) para detectar conexiones muertas, en ms
HEARTBEAT_MS=30000
# Servicio de auth: de aquí se lee la duración vigente de los tokens (GET /token-policy)
AUTH_URL=http://localhost:4000
# Cada cuánto se consulta esa duración, en ms
POLICY_POLL_MS=5000

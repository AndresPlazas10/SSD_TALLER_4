# Puerto HTTP + WebSocket del coordinador (lo usan los jugadores)
PORT=5000
# --- Mesh de coordinadores (Taller 6) ---
# Identificador único en el mesh. Para varios coordinadores en un mismo equipo,
# en vez de editar el .env usar: npm run start:a / start:b / start:c
# (o: node index.js --id coord-b --port 5002 --peer-port 5102)
COORDINATOR_ID=coord-a
# Puerto donde este coordinador recibe a los demás coordinadores (por defecto PORT + 100)
PEER_PORT=5100
# IP o host por el que los navegadores y los otros coordinadores llegan a ESTE
# equipo (ipconfig). Con todo en un solo equipo: localhost
PUBLIC_HOST=localhost
# Opcional: URLs completas que se anuncian en el directorio (p. ej. un túnel de
# ngrok wss://...). Si faltan: ws://PUBLIC_HOST:PORT y ws://PUBLIC_HOST:PEER_PORT
# PUBLIC_URL=wss://TU-URL-COORDINADOR.ngrok-free.app
# PEER_URL=ws://192.168.1.11:5100
# Debe ser EXACTAMENTE la misma secret que auth-service/.env (mínimo 32 caracteres).
# Auth y coordinador están en equipos distintos: copiarla tal cual entre los dos .env
JWT_SECRET=cambia_esto_por_64_caracteres_hex_aleatorios_0123456789abcdef
# Segundos de diferencia de reloj tolerados entre el equipo del auth y este al validar exp
JWT_CLOCK_TOLERANCE_S=5
# Duración máxima de la sesión desde que se emitió el token (30s, 5m, 1h).
# Vacío = sin límite extra (solo el exp del token). Se relee en caliente y se
# aplica también a las sesiones abiertas.
SESSION_MAX_AGE=
# URL del auth-service (equipo A). Es el DIRECTORIO del mesh: el coordinador se
# anuncia ahí cada 2 s (POST /heartbeat) y descubre a sus pares (GET /peers).
# También consulta /token-policy (JWT_EXPIRES_IN en caliente).
# Vacío = coordinador solo, sin directorio ni mesh. En LAN: http://<IP-equipo-A>:4000
AUTH_URL=http://localhost:4000
# Cada cuánto se consulta, en ms
TOKEN_POLICY_POLL_MS=1000
# Intervalo del heartbeat (ping/pong) para detectar conexiones muertas, en ms
HEARTBEAT_MS=30000
# Mundo del juego en px: una manzana cada 200 px (2400 x 1800 = 12 x 9 manzanas)
WORLD_WIDTH=2400
WORLD_HEIGHT=1800
PLAYER_RADIUS=20
# Velocidad en px/seg y frecuencia del game loop en Hz
PLAYER_SPEED=200
TICK_RATE=20
# Partida Uber vs Taxi: duración de cada ronda y pausa entre rondas, en segundos
MATCH_SECONDS=180
MATCH_BREAK_SECONDS=10
# Estructuras de la ciudad (colisiones). off = mundo vacío, solo para pruebas
OBSTACLES=on

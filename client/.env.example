# Puerto donde se sirve el cliente web
PORT=3000
# URLs que usa el navegador cuando el cliente se abre por http://localhost:3000.
# Auth y coordinador corren en OTROS equipos: usar la IP LAN de cada uno
# (ipconfig en Windows), NO localhost.
AUTH_URL=http://192.168.1.10:4000
COORDINATOR_WS=ws://192.168.1.11:5000
# URLs públicas de ngrok (cuando el cliente se abre por su túnel). Usar https:// y wss://
PUBLIC_AUTH_URL=https://TU-URL-AUTH.ngrok-free.app
PUBLIC_COORDINATOR_WS=wss://TU-URL-COORDINADOR.ngrok-free.app
# Client ID de OAuth de Google: el MISMO que auth-service/.env
GOOGLE_CLIENT_ID=TU-CLIENT-ID.apps.googleusercontent.com

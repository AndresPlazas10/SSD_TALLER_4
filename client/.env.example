# Puerto donde se sirve el cliente web
PORT=3000
# URLs que usa el navegador cuando el cliente se abre por http://localhost:3000.
# Auth y coordinador corren en OTROS equipos: usar la IP LAN de cada uno
# (ipconfig en Windows), NO localhost.
# AUTH_URL también es el directorio: el cliente le pide GET /coordinator y se
# conecta al coordinador que le diga (el menos cargado).
AUTH_URL=https://backside-cufflink-reapprove.ngrok-free.dev
# Solo de respaldo, si el auth no tuviera directorio (Taller 5)
COORDINATOR_WS=ws://localhost:5000
# URLs públicas de ngrok (cuando el cliente se abre por su túnel). Usar https:// y wss://
PUBLIC_AUTH_URL=https://backside-cufflink-reapprove.ngrok-free.dev
PUBLIC_COORDINATOR_WS=wss://TU-URL-COORDINADOR.ngrok-free.dev
# Client ID de OAuth de Google: el MISMO que auth-service/.env
GOOGLE_CLIENT_ID=165751275821-e6iobi93itak66f5ne8a2m91aqu2i8gc.apps.googleusercontent.com

# Puerto HTTP del servicio de autenticación
PORT=4000
# Secret para firmar los JWT: mínimo 32 caracteres (el servicio no arranca con menos).
# DEBE ser la misma que en coordinator/.env. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_64_caracteres_hex_aleatorios_0123456789abcdef
# Expiración del token: 1h en producción, 30s para la demo de token vencido
JWT_EXPIRES_IN=1h
# Rondas de bcrypt (mínimo 10)
BCRYPT_ROUNDS=10
# Client ID de OAuth (Google Cloud Console -> Credentials). El mismo va en client/.env
GOOGLE_CLIENT_ID=165751275821-e6iobi93itak66f5ne8a2m91aqu2i8gc.apps.googleusercontent.com
# Archivo de la base de datos SQLite
DB_FILE=users.db

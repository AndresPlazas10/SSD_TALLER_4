# Puerto HTTP del servicio de autenticación
PORT=4000
# Secret para firmar los JWT (DEBE ser la misma que en coordinator/.env)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
# Expiración del token: 1h en producción, 30s para la demo de token vencido
JWT_EXPIRES_IN=1h
# Rondas de bcrypt (mínimo 10)
BCRYPT_ROUNDS=10
# Archivo de la base de datos SQLite
DB_FILE=users.db

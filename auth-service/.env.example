# Puerto HTTP del servicio de autenticación
PORT=4000
# Secret para firmar los JWT: mínimo 32 caracteres (el servicio no arranca con menos).
# DEBE ser la misma que en coordinator/.env. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_64_caracteres_hex_aleatorios_0123456789abcdef
# Expiración del token: 1h en producción, 30s para la demo de token vencido
JWT_EXPIRES_IN=1h
# Rondas de bcrypt (mínimo 10)
BCRYPT_ROUNDS=10
# Client ID de OAuth (Google Cloud Console -> Credentials). El mismo va en client/.env
GOOGLE_CLIENT_ID=165751275821-e6iobi93itak66f5ne8a2m91aqu2i8gc.apps.googleusercontent.com
# Archivo de la base de datos SQLite
DB_FILE=users.db
# Directorio de coordinadores (Taller 6): ms sin heartbeat para dar a un
# coordinador por muerto (3 ciclos de 2 s)
DIRECTORY_TTL_MS=6000

# ===== Replicación (Taller 7) =====
# Vacío = un solo auth (siempre líder), como en los talleres anteriores.
# Con varios: la MISMA lista en los tres (cada uno se salta a sí mismo).
#   Un equipo:      auth-a=ws://localhost:4100,auth-b=ws://localhost:4101,auth-c=ws://localhost:4102
#   Tres equipos:   auth-a=ws://192.168.1.10:4100,auth-b=ws://192.168.1.11:4100,auth-c=ws://192.168.1.12:4100
#   Con ngrok (el cluster entra por /mesh del puerto HTTP, un túnel por auth):
#                   auth-a=wss://xxx.ngrok-free.dev/mesh,auth-b=wss://yyy.ngrok-free.dev/mesh,...
AUTH_PEERS=
# Identidad de este auth en el cluster (también por --id)
AUTH_ID=auth-a
# Puerto WS del cluster, separado del HTTP (también por --peer-port). Vacío = solo /mesh del puerto HTTP
PEER_PORT=
# URL HTTP con la que los navegadores y coordinadores llegan a ESTE auth (va en
# leaderUrl). Detrás de ngrok: la https://...ngrok-free.dev. Vacío = http://localhost:PORT
PUBLIC_URL=
# URL WS con la que los OTROS auth llegan a este. Vacío = ws://localhost:PEER_PORT (o .../mesh)
PEER_URL=
# Tiempos: heartbeat del líder y elección si una réplica no lo escucha en ese tiempo
AUTH_HEARTBEAT_MS=2000
AUTH_ELECTION_TIMEOUT_MS=6000
# Opción B: cuánto espera el líder la confirmación de una réplica antes de responder 503
AUTH_ACK_TIMEOUT_MS=3000
# Una réplica atiende lecturas (login) si está menos de esto atrasada respecto del líder
READ_LAG_TOLERANCE=10
